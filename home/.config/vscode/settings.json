{
  "workbench.colorTheme": "1. DARKㅤㅤ(Lynx Theme)",
  "editor.fontFamily": "Hack Nerd Font",
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "Hack Nerd Font Mono",
  "workbench.iconTheme": "lynx-pro-light",
  "window.zoomLevel": 2,
  "editor.fontSize": 10,
  "terminal.integrated.fontSize": 10,
  "chat.fontSize": 12,
  "chat.editor.fontSize": 12,
  "workbench.productIconTheme": "fluent-icons",

  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "prettier.tabWidth": 2,
  "prettier.proseWrap": "preserve",

  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "nix.formatterPath": "@PROFILE_DIRECTORY@/bin/nixfmt",
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "stylua.styluaPath": "@PROFILE_DIRECTORY@/bin/stylua",
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "shellformat.path": "@PROFILE_DIRECTORY@/bin/shfmt",
  "shellformat.flag": "-i 2 -ci",
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "git.confirmSync": false
}
