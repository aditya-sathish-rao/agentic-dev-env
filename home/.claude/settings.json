{
  "model": "anthropic/claude-sonnet-5.5",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "lavish-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); echo \"$input\" | jq -r '\"\\u001b[36m\\(.model.display_name)\\u001b[0m | ctx: \\((.context_window.total_input_tokens // 0) / 1000 | floor)k / \\((.context_window.context_window_size // 0) / 1000 | floor)k (\\(.context_window.used_percentage // 0)%) | out: \\(.context_window.total_output_tokens // 0) tok\"'"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
