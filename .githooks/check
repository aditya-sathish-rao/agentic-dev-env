#!/usr/bin/env bash
# Format and lint the repo. --all covers every tracked file, evaluates the flake.
set -euo pipefail

usage() {
  echo "usage: .githooks/check [--staged|--all]"
}

root=$(git rev-parse --show-toplevel)
cd "$root"

# GUI-launched git (VS Code) may not inherit the login shell PATH.
user=$(id -un)
export PATH="/etc/profiles/per-user/$user/bin:$HOME/.nix-profile/bin:$PATH"

mode=staged
for arg in "$@"; do
  case "$arg" in
    --staged) mode=staged ;;
    --all) mode=all ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "check: unknown option: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$mode" == all ]]; then
  list_cmd=(git ls-files -z)
else
  list_cmd=(git diff --cached --name-only --diff-filter=ACMR -z)
fi

files=()
while IFS= read -r -d '' file; do
  # Vendored skills stay byte-for-byte close to their source, so neither the
  # formatters nor the linters touch them. Same rule as .prettierignore, applied
  # here because shfmt and shellcheck do not read that file.
  case "$file" in
    home/.agents/skills/*) continue ;;
  esac
  files+=("$file")
done < <("${list_cmd[@]}")

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

nix_files=()
sh_files=()
lua_files=()
json_files=()
md_files=()
toml_files=()
yaml_files=()

# Classify by extension first, then by shebang: the shell scripts here have no
# extension (.githooks/check, home/.local/bin/pi), so an extension-only case would
# never format or lint them.
file_type() {
  case "$1" in
    *.nix) echo nix ;;
    *.lua) echo lua ;;
    *.json | *.jsonc) echo json ;;
    *.md) echo md ;;
    *.toml) echo toml ;;
    *.yml | *.yaml) echo yaml ;;
    *.sh) echo sh ;;
    *)
      local first=''
      IFS= read -r first <"$1" || true
      case "$first" in
        '#!'*bash* | '#!'*'/sh'* | '#!'*' sh'*) echo sh ;;
        *) echo '' ;;
      esac
      ;;
  esac
}

for file in "${files[@]}"; do
  [[ -f "$file" ]] || continue
  case "$(file_type "$file")" in
    nix) nix_files+=("$file") ;;
    sh) sh_files+=("$file") ;;
    lua) lua_files+=("$file") ;;
    json) json_files+=("$file") ;;
    md) md_files+=("$file") ;;
    toml) toml_files+=("$file") ;;
    yaml) yaml_files+=("$file") ;;
  esac
done

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "check: $1 not found; run ./rebuild.sh first." >&2
    exit 1
  fi
}

before=$(mktemp)
after=$(mktemp)
trap 'rm -f "$before" "$after"' EXIT

hash_files() {
  for file in "${files[@]}"; do
    [[ -f "$file" ]] || continue
    printf '%s  %s\n' "$(git hash-object -- "$file")" "$file"
  done >"$1"
}

hash_files "$before"

if [[ ${#nix_files[@]} -gt 0 ]]; then
  need nixfmt
  nixfmt "${nix_files[@]}"
fi

if [[ ${#sh_files[@]} -gt 0 ]]; then
  need shfmt
  shfmt -w -i 2 -ci "${sh_files[@]}"
fi

if [[ ${#lua_files[@]} -gt 0 ]]; then
  need stylua
  stylua "${lua_files[@]}"
fi

prettier_args=()
if [[ ${#json_files[@]} -gt 0 ]]; then prettier_args+=("${json_files[@]}"); fi
if [[ ${#md_files[@]} -gt 0 ]]; then prettier_args+=("${md_files[@]}"); fi
if [[ ${#yaml_files[@]} -gt 0 ]]; then prettier_args+=("${yaml_files[@]}"); fi
if [[ ${#prettier_args[@]} -gt 0 ]]; then
  need prettier
  prettier --write --log-level warn "${prettier_args[@]}"
fi

if [[ ${#toml_files[@]} -gt 0 ]]; then
  need taplo
  taplo fmt "${toml_files[@]}"
fi

hash_files "$after"

formatted=0
if ! cmp -s "$before" "$after"; then
  formatted=1
fi

status=0

if [[ ${#nix_files[@]} -gt 0 ]]; then
  need statix
  for file in "${nix_files[@]}"; do
    statix check "$file" || status=1
  done
  need deadnix
  deadnix --fail "${nix_files[@]}" || status=1
fi

if [[ ${#sh_files[@]} -gt 0 ]]; then
  need shellcheck
  shellcheck "${sh_files[@]}" || status=1
fi

if [[ ${#lua_files[@]} -gt 0 ]]; then
  need selene
  selene --config selene.toml "${lua_files[@]}" || status=1
fi

if [[ ${#toml_files[@]} -gt 0 ]]; then
  need taplo
  taplo lint "${toml_files[@]}" || status=1
fi

# Every principle skill must appear in the index skill, because that index is the
# layer every harness reads. A principle added without it would silently not apply.
principle_index=home/.agents/skills/engineering-principles/SKILL.md
if [[ -f "$principle_index" ]]; then
  for dir in home/.agents/skills/software-engineering-principles/principle-*/; do
    [[ -d "$dir" ]] || continue
    name=$(basename "$dir")
    if ! grep -qF -- "$name" "$principle_index"; then
      echo "check: $name is missing from $principle_index" >&2
      status=1
    fi
  done
fi

if [[ "$mode" == all ]]; then
  if command -v nix >/dev/null 2>&1; then
    nix_user="${AGENTIC_DEV_ENV_USER:-$(id -un)}"
    # Same identity rebuild.sh uses. The host is not read from the environment
    # here: the loop below names each configuration explicitly.
    export AGENTIC_DEV_ENV_USER="$nix_user"
    export AGENTIC_DEV_ENV_HOME="${AGENTIC_DEV_ENV_HOME:-$HOME}"
    # personal.nix is gitignored, so the flake cannot see it as a tracked file;
    # nix/personal.nix imports it by this absolute path. Absent, the generic
    # defaults apply and the evaluation still proves the configuration.
    export AGENTIC_DEV_ENV_PERSONAL="$root/personal.nix"
    # Every machine's configuration is evaluated, not just this one: a host file
    # that stops evaluating should fail here rather than on the machine it names.
    for host in primary mini; do
      if ! nix --extra-experimental-features 'nix-command flakes' eval --impure --raw \
        ".#darwinConfigurations.$host.system.drvPath" >/dev/null; then
        echo "check: nix evaluation failed for $host; fix the configuration before it reaches main." >&2
        exit 1
      fi
    done
  else
    echo "check: nix not found; skipping the configuration evaluation." >&2
  fi
fi

# Re-stage only the files the formatters rewrote. A blanket `git add` would also
# stage the unstaged hunks of partially staged files.
if [[ "$mode" == staged ]]; then
  for file in "${files[@]}"; do
    [[ -f "$file" ]] || continue
    if ! grep -qxF -- "$(git hash-object -- "$file")  $file" "$before"; then
      git add -- "$file"
    fi
  done
fi

if [[ $formatted -eq 1 ]]; then
  if [[ "$mode" == staged ]]; then
    echo "check: formatters updated staged files." >&2
  else
    echo "check: formatters changed files; review and stage the fixes." >&2
    exit 1
  fi
fi

if [[ $status -ne 0 ]]; then
  echo "check: lint failed; fix the issues above." >&2
  exit 1
fi
