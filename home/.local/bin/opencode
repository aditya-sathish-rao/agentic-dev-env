#!/usr/bin/env bash
# Supply the vault keys, and prefer the DeepSeek platform without letting a dead
# key or a direct outage fail the crewmate.
#
# Keys: crewmate panes come from a herdr server that never saw the keys `mate`
# injects, so a launch that selects a deepseek/ or openrouter/ model while
# DEEPSEEK_API_KEY or OPENROUTER_API_KEY is unset re-runs this wrapper under
# `av inject`. Each worker holds the keys only for its own lifetime. If av fails
# (approval denied) the launch stops, because without the env key opencode would
# fall back to a stale credential in its auth.json. No av on PATH: pass through.
#
# Fallback: firstmate resolves one profile per crewmate and neither it nor
# opencode retries after a failed call, so this wrapper checks once at launch: if
# the launch asks for a direct DeepSeek model and api.deepseek.com rejects the
# vault key, the launch is rewritten to the OpenRouter equivalent.
#
# Pass-through everywhere else: no model flag, another provider, other commands.
set -u

fallback=openrouter/deepseek/deepseek-v4.1-flash

# Resolve the harness this file shadows by looking past ~/.local/bin.
real=''
IFS=: read -ra dirs <<<"$PATH"
for dir in "${dirs[@]}"; do
  [[ $dir == "$HOME/.local/bin" ]] && continue
  if [[ -x $dir/opencode ]]; then
    real=$dir/opencode
    break
  fi
done
if [[ -z $real ]]; then
  echo "opencode: the real harness is not on PATH" >&2
  exit 127
fi

args=("$@")
model_value=''  # the array entry holding the model id, whichever flag wrote it
for i in "${!args[@]}"; do
  case ${args[i]} in
    --model | -m) model_value=$((i + 1)) ;;
    --model=?* | -m=?*) model_value=$i ;;
  esac
done

if [[ -n $model_value && $model_value -lt ${#args[@]} ]]; then
  model=${args[model_value]}
  model=${model#--model=}
  model=${model#-m=}
  if [[ $model == deepseek/* || $model == openrouter/* ]] &&
    [[ -z ${DEEPSEEK_API_KEY:-} || -z ${OPENROUTER_API_KEY:-} ]]; then
    # OPENCODE_AV_SENTINEL marks the re-run: it is the file the inner wrapper
    # fills once av has handed it the keys, so the outer one can tell an av
    # failure from the harness itself exiting nonzero.
    if [[ -n ${OPENCODE_AV_SENTINEL:-} ]]; then
      exit 1
    fi
    if command -v av >/dev/null 2>&1; then
      sentinel=$(mktemp) || exit 1
      OPENCODE_AV_SENTINEL=$sentinel \
        av inject +DEEPSEEK_API_KEY +OPENROUTER_API_KEY -- "$0" "$@"
      status=$?
      if [[ $status -ne 0 && ! -s $sentinel ]]; then
        rm -f "$sentinel"
        echo "opencode: the vault keys could not be injected (av exited $status or left a key unset)" >&2
        exit "$status"
      fi
      rm -f "$sentinel"
      exit "$status"
    fi
  fi
  if [[ $model == deepseek/* && -n ${DEEPSEEK_API_KEY:-} && -n ${OPENROUTER_API_KEY:-} ]]; then
    code=$(curl -s -o /dev/null -m 4 -w '%{http_code}' \
      -H "Authorization: Bearer $DEEPSEEK_API_KEY" \
      https://api.deepseek.com/models 2>/dev/null) || code=''
    # An empty code means the check itself could not run (offline, no curl):
    # leave the launch alone rather than switching on no evidence.
    if [[ $code =~ ^[0-9]{3}$ && $code != 200 ]]; then
      if [[ ${args[model_value]} == *=* ]]; then
        args[model_value]="${args[model_value]%%=*}=$fallback"
      else
        args[model_value]=$fallback
      fi
      printf 'opencode: deepseek direct unusable (HTTP %s), using %s\n' \
        "$code" "$fallback" >&2
    fi
  fi
fi

# Inner run under av: record that the keys arrived (the block above would have
# stopped the launch otherwise).
[[ -n ${OPENCODE_AV_SENTINEL:-} ]] && echo ok >"$OPENCODE_AV_SENTINEL"
exec "$real" "${args[@]}"
