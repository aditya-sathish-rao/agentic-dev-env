#!/usr/bin/env bash
# Supply the vault key to a crewmate pane.
#
# `mate` injects the model key into the first mate only. Crewmate panes are
# opened by a herdr server that never saw that key, so a launch that needs one
# re-runs this wrapper under `av inject` and the worker holds the key only for
# its own lifetime. An av failure stops the launch instead of leaving pi to run
# signed out; with no av on PATH the wrapper passes through unchanged.
#
# The secret's name is not hardcoded: home.nix generates it from personal.nix
# into ~/.config/agentic-dev-env/model-key-secret, so no tracked file names a
# provider. Without that file there is no key to inject and the wrapper passes
# through.
#
# Probes that cannot use a model key (`--help`, `--version`, `auth`, `update`,
# `--list-models`) pass through, so firstmate's help and version detection never
# waits on a vault approval. Only the first argument decides: a later word that
# happens to be "auth" is prompt text, not a subcommand.
set -u

real=''
IFS=: read -ra dirs <<<"$PATH"
for dir in "${dirs[@]}"; do
  [[ $dir == "$HOME/.local/bin" ]] && continue
  if [[ -x $dir/pi ]]; then
    real=$dir/pi
    break
  fi
done
if [[ -z $real ]]; then
  echo "pi: the real harness is not on PATH" >&2
  exit 127
fi

case ${1:-} in
  --help | --version | --list-models | auth | update) exec "$real" "$@" ;;
esac

key_file="$HOME/.config/agentic-dev-env/model-key-secret"
key=''
[[ -r $key_file ]] && IFS= read -r key <"$key_file"

if [[ -n $key && -z ${!key:-} ]] && command -v av >/dev/null 2>&1; then
  exec av inject "+$key" -- "${BASH_SOURCE[0]}" "$@"
fi

exec "$real" "$@"
